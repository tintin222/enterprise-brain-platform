# Enterprise Brain installation settings (docs: install/README.md). `./install/brain init` copies this file to
# config.env, generates every empty secret and derives the addresses; nothing here is overwritten later except
# the two Mattermost tokens the seed writes. Keep config.env private (mode 600): it holds the installation's keys.

# --- Addresses ---
# With domains, Caddy terminates TLS with Let's Encrypt certificates; without, the services listen on the ports below.
DOMAIN_CHAT=
DOMAIN_BRAIN=
ACME_EMAIL=
# Used when no domains are set: the chat on http://HOST_ADDRESS:8065, the brain on http://HOST_ADDRESS:9120.
HOST_ADDRESS=localhost
# Derived from the lines above when empty; set them yourself to put a different proxy in front.
MM_URL=
BRAIN_PUBLIC_URL=
# Where Mattermost reaches the brain API inside the Docker network (spike B1).
BRAIN_INTERNAL_URL=http://brain-api:9120

# --- Workspace ---
MM_TEAM_NAME=company
MM_TEAM_DISPLAY_NAME=Company
MM_ADMIN_USERNAME=admin
MM_ADMIN_EMAIL=admin@example.com
MM_ADMIN_PASSWORD=
# Written by the seed: the @brain bot's token and the admin's token for agent provisioning (D25).
MM_BRIDGE_TOKEN=
MM_ADMIN_TOKEN=
MM_DB_PASSWORD=

# --- Keys and secrets (generated) ---
BRIDGE_SECRET_KEY=
READER_SECRET_KEY=
KEY_ENCRYPTION_KEY=
BRAIN_API_TOKEN=
BRAIN_SESSION_SECRET=
RELAY_OWNER_PUBKEY=
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=
BUZZ_DB_PASSWORD=
BUZZ_REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media

# --- Our state database (inside the Docker network) ---
STATE_DB_HOST=state-postgres
STATE_DB_PORT=5432
STATE_DB_PASSWORD=
STATE_DATABASE_URL=

# --- Relay (inside the Docker network; the host in RELAY_WS_URL names the relay's community) ---
RELAY_WS_URL=ws://relay:3000
RELAY_HTTP_URL=http://relay:3000
BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=1200
BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=50

# --- Models (D21, D54, D56). Agents with model "echo" need no key. ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-3.5-flash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MODEL_PRICES_JSON=

# --- The brain (D50, D55) ---
BRAIN_FEATURE_API=true
BRAIN_FEATURE_CHAT_COMMANDS=true
BRAIN_FEATURE_SEMANTIC_SEARCH=auto
# Phase 1 features: workspaces, people, systems, documents, tasks, reminders; OCR through the model provider.
BRAIN_FEATURE_PROJECTS=true
BRAIN_FEATURE_PEOPLE=true
BRAIN_FEATURE_SYSTEMS=true
BRAIN_FEATURE_DOCUMENTS=true
BRAIN_FEATURE_TASKS=true
BRAIN_FEATURE_REMINDERS=true
BRAIN_FEATURE_OCR_MODEL=true
# Largest upload in MB; days without activity before a project is flagged stale; local hour of task reminders.
BRAIN_FILE_MAX_MB=50
BRAIN_STALE_DAYS=14
BRAIN_REMINDER_HOUR=8
BRAIN_EXTRACT_CONCURRENCY=2
BRAIN_CAPTURE_CHANNELS=all
CAPTURE_SWEEP_SECONDS=60
BRAIN_SESSION_HOURS=12
BRAIN_TIMEZONE=Europe/Istanbul
EMBED_INTERVAL_SECONDS=2
EMBED_BATCH_SIZE=64

# --- Services ---
LOG_LEVEL=info
BACKFILL_DAYS=0
RELAY_OVERLAP_SECONDS=600
CATCH_UP_INTERVAL_SECONDS=300
RECONCILE_INTERVAL_SECONDS=300
MAX_EVENT_AGE_SECONDS=600
MAX_REPLIES_PER_THREAD=10
REPLY_WINDOW_SECONDS=3600
JOB_CONCURRENCY=4
AGENT_REFRESH_SECONDS=30
CONTEXT_CHAR_BUDGET=60000
INGEST_DEBOUNCE_SECONDS=30
INGEST_CHUNK_CHARS=6000
RELAY_REQUESTS_PER_SECOND=15
MM_REQUESTS_PER_SECOND=20
OPS_HOST=0.0.0.0
BRIDGE_OPS_PORT=9101
RUNTIME_OPS_PORT=9102
INGESTION_OPS_PORT=9103
BRAIN_API_HOST=0.0.0.0
BRAIN_API_PORT=9120
