{
  "name": "enterprise-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev:up": "tsx scripts/dev/up.ts",
    "dev:down": "tsx scripts/dev/down.ts",
    "dev:seed": "tsx scripts/dev/seed.ts",
    "bridge": "tsx packages/bridge/src/main.ts",
    "dead-letter": "tsx packages/bridge/src/cli/dead-letter.ts",
    "agent-runtime": "tsx packages/agent-runtime/src/main.ts",
    "agent:provision": "tsx packages/agent-runtime/src/cli/provision.ts",
    "agent:echo": "tsx packages/agent-runtime/src/cli/echo.ts",
    "ingestion": "tsx packages/ingestion/src/main.ts",
    "ingest:purge": "tsx packages/ingestion/src/cli/purge.ts",
    "brain-api": "tsx packages/brain-api/src/main.ts",
    "brain:api-docs": "tsx packages/brain-api/src/cli/api-docs.ts",
    "brain:setup": "tsx packages/brain-api/src/cli/setup.ts",
    "spike": "tsx scripts/spike/run.ts",
    "gen:emoji": "tsx scripts/gen/emoji.ts",
    "keys:rotate-master": "tsx scripts/keys/rotate-master.ts",
    "keys:rotate-reader": "tsx scripts/keys/rotate-reader.ts",
    "keys:rotate-bridge": "tsx scripts/keys/rotate-bridge.ts",
    "relay:wipe": "tsx scripts/ops/relay-wipe.ts",
    "relay:rebuild": "tsx scripts/ops/relay-rebuild.ts",
    "check:logs": "tsx scripts/ops/check-logs.ts",
    "load-test": "tsx scripts/load/run.ts",
    "staging:railway": "ENV_FILE=.env.staging tsx scripts/staging/railway.ts",
    "staging:agent": "tsx scripts/staging/agent.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
