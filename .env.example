# Local development settings. `pnpm dev:up` copies this file to .env, generates every empty value
# that has a generator (keys, passwords) and derives the computed ones. Existing .env values are
# never overwritten. `pnpm dev:seed` writes MM_BRIDGE_TOKEN. Never commit .env.

# Mattermost build: "team" (Team Edition, capped at 250 users), "mostlymatter" (no cap, same version) or
# "enterprise-brain" (our fork: no cap, our branding). Set with `pnpm dev:up --enterprise-brain` / `--mostlymatter` /
# `--team-edition` (D11, D22, D48).
MATTERMOST_EDITION=team

# --- Endpoints, as seen from the host ---
MM_URL=http://localhost:8065
RELAY_WS_URL=ws://localhost:3000
RELAY_HTTP_URL=http://localhost:3000

# --- Service keys (hex secret keys, generated) ---
# The bridge key is also the relay owner (RELAY_OWNER_PUBKEY below is derived from it).
BRIDGE_SECRET_KEY=
READER_SECRET_KEY=
# Master key for the key store (Phase 1), 32 random bytes as hex.
KEY_ENCRYPTION_KEY=

# --- Our state database ---
# Host and port as seen by the services (staging: state-postgres.railway.internal and 5432).
STATE_DB_HOST=localhost
STATE_DB_PORT=5433
STATE_DB_PASSWORD=
# Derived from STATE_DB_HOST, STATE_DB_PORT and STATE_DB_PASSWORD.
STATE_DATABASE_URL=

# --- Mattermost ---
MM_TEAM_NAME=brain-dev
MM_TEAM_DISPLAY_NAME=Brain Dev
MM_ADMIN_USERNAME=sysadmin
MM_ADMIN_PASSWORD=
# Password shared by the two dev people, alice and bob.
MM_PERSON_PASSWORD=
# Access token of the @brain bot. Written by `pnpm dev:seed`.
MM_BRIDGE_TOKEN=
# Admin user token for agent provisioning (bots cannot create bots, D25). Written by `pnpm dev:seed`.
MM_ADMIN_TOKEN=
MM_DB_PASSWORD=

# --- Buzz relay ---
# Derived from BRIDGE_SECRET_KEY.
RELAY_OWNER_PUBKEY=
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=
BUZZ_DB_PASSWORD=
BUZZ_REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media
# --- Services (bridge, agent-runtime, ingestion) ---
LOG_LEVEL=info
# Days of history the bridge mirrors when a channel is enabled (0 disables backfill).
BACKFILL_DAYS=0
# How far before its cursor relay catch-up re-reads.
RELAY_OVERLAP_SECONDS=600
# How often the bridge re-reads Mattermost channels from their cursors, besides start and reconnect.
CATCH_UP_INTERVAL_SECONDS=300
# How often the bridge reconciles channel state, metadata and relay membership with Mattermost (also at start).
RECONCILE_INTERVAL_SECONDS=300
# Agents ignore mentions older than this (by the mm_ts tag when present).
MAX_EVENT_AGE_SECONDS=600
# Reply cap per agent per thread within the window (D26).
MAX_REPLIES_PER_THREAD=10
REPLY_WINDOW_SECONDS=3600
JOB_CONCURRENCY=4
# How often agent-runtime re-reads the agent list (a mention of an agent it does not know yet re-reads it at once).
AGENT_REFRESH_SECONDS=30
CONTEXT_CHAR_BUDGET=60000
# Ingestion: a changed thread is re-indexed at most this long after its first change; longer threads are chunked.
INGEST_DEBOUNCE_SECONDS=30
INGEST_CHUNK_CHARS=6000

# --- Models (D21, D54, D56). Agents with model "echo" need no key. ---
# The vendor an agent uses when its record names none: anthropic or google.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Google AI key for the Gemini provider and embeddings (D53). Empty keeps semantic search off; keyword search still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-3.5-flash
# Embeddings for semantic search: auto (Google when GEMINI_API_KEY is set, otherwise none), google, mock (tests) or none.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Optional price table for cost reporting (NFR-7): {"<model id or prefix>": {"inputPerMillion": 5, "outputPerMillion": 25, "cacheReadPerMillion": 0.5}}
MODEL_PRICES_JSON=

# Operations endpoints (/healthz, /readyz, /metrics) of each service (docs/operations.md).
OPS_HOST=127.0.0.1
BRIDGE_OPS_PORT=9101
RUNTIME_OPS_PORT=9102
INGESTION_OPS_PORT=9103
# --- The brain API and pages (pnpm brain-api; docs/brain/01-phase0-plan.md) ---
BRAIN_API_HOST=0.0.0.0
BRAIN_API_PORT=9120
# Where browsers reach the pages, and where Mattermost (in Docker) reaches the API for command callbacks.
BRAIN_PUBLIC_URL=http://localhost:9120
BRAIN_INTERNAL_URL=http://host.docker.internal:9120
# Service token for machine clients (scripts, tests) and the key that signs session cookies; both generated.
BRAIN_API_TOKEN=
BRAIN_SESSION_SECRET=
BRAIN_SESSION_HOURS=12
BRAIN_TIMEZONE=Europe/Istanbul
# Feature flags (D55): the API and pages, the /brain chat command, semantic search (auto: on when a Gemini key is set).
BRAIN_FEATURE_API=true
BRAIN_FEATURE_CHAT_COMMANDS=true
BRAIN_FEATURE_SEMANTIC_SEARCH=auto
# Which channels the bridge captures for the brain (D50): all, public or opt-in; and how often it looks.
BRAIN_CAPTURE_CHANNELS=all
CAPTURE_SWEEP_SECONDS=60
# Embedding worker: how often it looks for chunks and how many it sends per round.
EMBED_INTERVAL_SECONDS=2
EMBED_BATCH_SIZE=64
# The built pages (packages/brain-web/dist); empty serves the API only.
BRAIN_WEB_DIR=packages/brain-web/dist
# Client-side write throttles: relay requests per second per key, Mattermost requests per second per token.
RELAY_REQUESTS_PER_SECOND=15
MM_REQUESTS_PER_SECOND=20

# Per-key relay rate limits (relay defaults 300 and 10), raised for the shared reader key (D20).
BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=1200
BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=50
